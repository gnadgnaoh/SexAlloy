+    private static Field firstField(Class<?> type, FieldFilter filter)
+    {
+        for (Field field : type.getDeclaredFields())
+        {
+            if (filter.accept(field))
+            {
+                field.setAccessible(true);
+                return field;
+            }
+        }
+        return null;
+    }
